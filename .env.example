# Environment for `docker compose up` at the repo root.
# Copy to .env before running: copy .env.example .env  (Windows) / cp .env.example .env (macOS/Linux)
#
# docker-compose.yml reads these to configure the postgres and backend
# services. See backend/.env.example for the full list of backend-specific
# variables (used instead when running the backend natively, outside Docker).

# --- PostgreSQL (used by the `postgres` service and by DATABASE_URL below) ---
POSTGRES_USER=absensi
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=absensi_db
POSTGRES_PORT=5432

# --- Backend (Go / Gin) ---
APP_ENV=development
APP_PORT=8080
DATABASE_URL=postgres://absensi:change-me-in-production@postgres:5432/absensi_db?sslmode=disable
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000
AUTO_MIGRATE=true
