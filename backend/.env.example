# Copy this file to .env for local (non-Docker) backend development:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS/Linux)
#
# In Docker/production these are provided by the container runtime /
# docker-compose.yml instead — this file is not read there.

APP_ENV=development
APP_PORT=8080

# Local Postgres running natively or via `docker compose up postgres`.
DATABASE_URL=postgres://absensi:absensi@localhost:5432/absensi_db?sslmode=disable

# Generate a real secret for anything beyond local dev, e.g.:
#   openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

LOG_LEVEL=debug

# Comma-separated list of origins allowed to call this API from a browser
# (the Next.js dashboard). The Flutter tablet app is unaffected by CORS.
ALLOWED_ORIGINS=http://localhost:3000

# Automatically apply pending migrations on server startup. Convenient for
# local dev; consider setting to false and running `go run ./cmd/migrate`
# explicitly in production deploys.
AUTO_MIGRATE=true
