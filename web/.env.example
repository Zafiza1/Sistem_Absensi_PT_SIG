# Copy to .env.local for local development:
#   cp .env.example .env.local

# Base URL of the Go backend's versioned API. The dashboard talks to it
# entirely client-side (fetch from the browser), so this must be reachable
# from wherever the browser runs, not just from the Next.js server.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
