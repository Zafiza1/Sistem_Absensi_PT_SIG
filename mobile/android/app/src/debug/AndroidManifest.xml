<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:usesCleartextTraffic="true"
        tools:targetApi="28"
        tools:replace="android:usesCleartextTraffic"
        xmlns:tools="http://schemas.android.com/tools"/>
    <!-- Debug builds only: the local backend during development runs over
         plain HTTP (localhost via `adb reverse`, or a LAN IP). Release
         builds inherit the main manifest's default of blocking cleartext
         traffic — production always talks to the backend over HTTPS
         (see docker-compose.yml / Nginx, Phase 8). -->
</manifest>
